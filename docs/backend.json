
{
  "entities": {
    "SiteSettings": {
      "title": "Site Settings",
      "description": "Configuration for home page sections and custom messaging.",
      "type": "object",
      "properties": {
        "menuEnabled": { "type": "boolean" },
        "locationEnabled": { "type": "boolean" },
        "customAnnouncement": { "type": "string" },
        "announcementEnabled": { "type": "boolean" },
        "welcomeImageId": { "type": "string" },
        "logoId": { "type": "string" }
      }
    },
    "Service": {
      "title": "Service",
      "description": "Managed services offered by the restaurant.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "isActive": { "type": "boolean" },
        "iconName": { "type": "string" }
      },
      "required": ["name", "isActive"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "A dish or drink on the restaurant menu.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "string" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "rating": { "type": "number" }
      },
      "required": ["name", "price", "category"]
    },
    "Category": {
      "title": "Category",
      "description": "Menu categories with custom icons.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["name"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order details and delivery information.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "kebele": { "type": "string" },
        "specialAddress": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "phoneNumber", "kebele", "totalAmount"]
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "settings/site": {
      "schema": "SiteSettings",
      "description": "Global site configuration"
    },
    "services/{serviceId}": {
      "schema": "Service",
      "description": "Managed restaurant services"
    },
    "menu/{itemId}": {
      "schema": "MenuItem",
      "description": "Restaurant menu items"
    },
    "categories/{categoryId}": {
      "schema": "Category",
      "description": "Menu categories"
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders"
    }
  }
}
