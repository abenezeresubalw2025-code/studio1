
{
  "entities": {
    "SiteSettings": {
      "title": "Site Settings",
      "description": "Configuration for home page sections and custom messaging.",
      "type": "object",
      "properties": {
        "menuEnabled": { "type": "boolean" },
        "aiNavigatorEnabled": { "type": "boolean" },
        "bookingEnabled": { "type": "boolean" },
        "locationEnabled": { "type": "boolean" },
        "customAnnouncement": { "type": "string" },
        "announcementEnabled": { "type": "boolean" },
        "welcomeImageId": { "type": "string" },
        "logoId": { "type": "string" }
      }
    },
    "Service": {
      "title": "Service",
      "description": "Managed services offered by the restaurant.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "isActive": { "type": "boolean" },
        "iconName": { "type": "string" }
      },
      "required": ["name", "isActive"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "settings/site": {
      "schema": "SiteSettings",
      "description": "Global site configuration"
    },
    "services/{serviceId}": {
      "schema": "Service",
      "description": "Managed restaurant services"
    }
  }
}
